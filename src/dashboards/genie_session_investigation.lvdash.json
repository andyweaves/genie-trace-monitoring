{
  "datasets": [
    {
      "name": "ds_sessions",
      "displayName": "Sessions",
      "queryLines": [
        "SELECT conversation_id, session_start, product, requester, severity,\n",
        "       round(risk_score, 2) AS risk_score,\n",
        "       array_join(flags.flag_labels, ', ') AS flag_labels,\n",
        "       array_join(flags.pii_entity_types, ', ') AS pii_entity_types,\n",
        "       activity.turn_count AS turns, activity.tool_call_count AS tool_calls,\n",
        "       array_join(activity.tools_used, ', ') AS tools_used, context.channel AS channel\n",
        "FROM genie_sessions\n",
        "ORDER BY is_flagged DESC, risk_score DESC, session_start DESC\n"
      ]
    },
    {
      "name": "ds_timeline",
      "displayName": "Session timeline",
      "queryLines": [
        "SELECT conversation_id, step_number, turn_number, started_at, event_type, event_name, tool_name,\n",
        "       is_flagged, array_join(detections.flags, ', ') AS flags, outcome.outcome AS outcome,\n",
        "       substr(input_text, 1, 2000) AS input_text, substr(output_text, 1, 2000) AS output_text\n",
        "FROM genie_session_timeline\n",
        "ORDER BY conversation_id, step_number\n"
      ]
    },
    {
      "name": "ds_detections",
      "displayName": "Findings",
      "queryLines": [
        "SELECT conversation_id, span_time, detected_at, detector, label, round(score, 3) AS score,\n",
        "       span.field AS field, span.trace_id AS trace_id, details\n",
        "FROM genie_detections\n",
        "WHERE flagged\n",
        "ORDER BY span_time\n"
      ]
    }
  ],
